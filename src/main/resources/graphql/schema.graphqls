type Query {
  user(id: ID!): User
  bio(id: ID!): Bio
  profile(id: ID!): Profile
  me(id: ID!): User
  myBio(id: ID!): Bio
  myProfile(id: ID!): Profile
  recommendations(id: ID!): [User]
  connections(id: ID!): [User]
}

type User {
  id: ID!
  username: String
  image: String
  bio: Bio
  profile: Profile
}

type Bio {
  id: ID!
  gender: String
  hobbies: [String]
}

type Profile {
  aboutme: String
  lookingFor: String
}
